// Skema database Aplikasi Tiket Antrian.
// Development: SQLite. Production: PostgreSQL (lihat README bagian "Deploy").

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
  moduleFormat        = "cjs"
}

datasource db {
  provider = "sqlite"
}

model EventDay {
  id       String    @id @default(cuid())
  date     String    @unique // "2026-11-27"
  label    String
  bookingRevision Int @default(0)
  sessions Session[]
}

model Session {
  id         String   @id @default(cuid())
  eventDayId String
  eventDay   EventDay @relation(fields: [eventDayId], references: [id])
  order      Int // 1..6
  startTime  String // "10:00"
  endTime    String // "10:45"
  queueStart Int // 1, 31, 61, ...
  queueEnd   Int // 30, 60, 90, ...
  tickets    Ticket[]
  holds      Hold[]

  @@unique([eventDayId, order])
}

model Ticket {
  id          String       @id @default(cuid())
  code        String       @unique // kode pendek, mis. "JM-027-X7K2"
  sessionId   String
  session     Session      @relation(fields: [sessionId], references: [id])
  date        String // duplikasi untuk unique constraint
  queueNumber Int
  name        String
  phone       String // dinormalisasi ke format 08xx
  email       String?
  status      TicketStatus @default(BOOKED)
  checkedInAt DateTime?
  createdAt   DateTime     @default(now())

  @@unique([date, queueNumber]) // CEGAH double booking di level DB
  @@index([phone])
}

// Kunci sementara (5 menit) saat pengunjung berada di halaman checkout.
model Hold {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id])
  date        String
  queueNumber Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([date, queueNumber])
}

// Arsip tiket yang dibatalkan. Baris Ticket dihapus saat dibatalkan agar
// unique (date, queueNumber) tetap konsisten dan nomornya bisa dipesan lagi.
model CancelledTicket {
  id           String    @id @default(cuid())
  code         String
  sessionId    String
  date         String
  queueNumber  Int
  name         String
  phone        String
  email        String?
  checkedInAt  DateTime?
  bookedAt     DateTime
  cancelledAt  DateTime  @default(now())

  @@index([date])
}

// Nomor antrian yang sedang dilayani, satu baris per tanggal.
model NowServing {
  date      String   @id
  number    Int
  updatedAt DateTime @updatedAt
}

enum TicketStatus {
  BOOKED
  CHECKED_IN
  CANCELLED
}

// POS berdiri sendiri: tidak memiliki relasi ke tiket, sesi, atau hari event.
model PosProduct {
  id        String @id @default(cuid())
  sku       String @unique
  name      String
  price     Int
  stock     Int @default(0)
  active    Boolean @default(true)
  revision  Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     PosSaleItem[]
  movements PosStockMovement[]
}

model PosSale {
  id            String @id @default(cuid())
  invoiceNumber String @unique
  requestKey    String @unique
  requestHash   String
  date          String
  customerName  String?
  paymentMethod String
  subtotal      Int
  discount      Int
  total         Int
  paid          Int
  change        Int
  cashierEmail  String
  note          String?
  createdAt     DateTime @default(now())
  items         PosSaleItem[]
  movements     PosStockMovement[]

  @@index([date, createdAt])
}

model PosSaleItem {
  id        String @id @default(cuid())
  saleId    String
  sale      PosSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId String
  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku       String
  name      String
  quantity  Int
  unitPrice Int
  lineTotal Int

  @@index([saleId])
}

model PosStockMovement {
  id           String @id @default(cuid())
  productId    String
  product      PosProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  saleId       String?
  sale         PosSale? @relation(fields: [saleId], references: [id], onDelete: Restrict)
  requestKey   String? @unique
  kind         String
  quantity     Int
  balance      Int
  reason       String
  cashierEmail String
  createdAt    DateTime @default(now())

  @@index([productId, createdAt])
}
