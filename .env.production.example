# Panduan variabel untuk Vercel Settings → Environment Variables.
# File contoh ini tidak dibaca otomatis oleh Vercel. Isi nilainya di dashboard.
# Pilih Production; tambahkan juga ke Preview jika memakai deployment preview.

# WAJIB: URL PostgreSQL dari database yang terhubung, bukan file:./dev.db.
DATABASE_URL=""

# WAJIB: email dan password akun admin untuk login /admin.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# OPSIONAL: domain publik tetap. Jika kosong, bagikan WhatsApp memakai domain saat ini.
NEXT_PUBLIC_BASE_URL=""

# OPSIONAL: koneksi langsung untuk migrasi, jika disediakan penyedia database.
# Jangan tambahkan variabel ini dengan nilai kosong; biarkan tidak di-set jika tidak dipakai.
# DATABASE_URL_UNPOOLED="postgresql://..."
